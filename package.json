{
  "name": "flux-ops",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "cross-env SALES_IMPORT_ONLY=1 electron .",
    "dev": "cross-env SALES_IMPORT_ONLY=1 concurrently \"npm:dev:renderer\" \"npm:dev:main\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:websdk": "cross-env VITE_FIREBASE_USE_WEBSDK=1 VITE_FIREBASE_BUSINESS_ID=default-business concurrently \"npm:dev:renderer\" \"npm:dev:main\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:firestore": "cross-env SALES_IMPORT_ONLY=0 FIRESTORE_READ_REALTIME=1 FIRESTORE_REALTIME_ORDERS_ONLY=1 FIRESTORE_ORDERS_READ_ONLY=1 FIRESTORE_USE_REMOTE_PRODUCTS=1 FIRESTORE_USE_REMOTE_SALES=1 FIREBASE_BUSINESS_ID=default-business GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json concurrently \"npm:dev:renderer\" \"npm:dev:main\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:firestore.inv": "cross-env SALES_IMPORT_ONLY=0 FIRESTORE_READ_REALTIME=1 FIRESTORE_REALTIME_ORDERS_ONLY=1 FIRESTORE_ORDERS_READ_ONLY=1 FIRESTORE_USE_REMOTE_PRODUCTS=1 FIRESTORE_USE_REMOTE_INGREDIENTS=1 FIRESTORE_USE_REMOTE_SALES=1 FIREBASE_BUSINESS_ID=default-business GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json concurrently \"npm:dev:renderer\" \"npm:dev:main\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run build:renderer && npm run build:main",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.7.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "better-sqlite3": "^8.0.0",
    "chart.js": "^4.5.1",
    "electron-is-dev": "^2.0.0",
    "firebase": "^11.7.0",
    "firebase-admin": "^11.10.0",
    "framer-motion": "^10.12.16",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "sql.js": "^1.7.0",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "serialport": "^10.5.0",
    "@serialport/parser-readline": "^10.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "electron": "^26.0.0",
    "electron-builder": "^24.0.0",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.flux.ops",
    "productName": "Flux Ops",
    "files": [
      "dist/**",
      "node_modules/**",
      "package.json"
    ],
    "extraResources": [
      "secrets/**",
      "staff.csv"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
